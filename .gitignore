# Public teaching materials. Notes, caches, archives and review files stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/SOURCES.md
!/mixtape/
!/cattaneo/

/mixtape/*
!/mixtape/README.md
!/mixtape/presentation/
!/mixtape/exercises/

/mixtape/presentation/*
