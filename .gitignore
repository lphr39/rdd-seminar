!/mixtape/presentation/assets/*.svg
!/mixtape/presentation/assets/*.png
!/mixtape/presentation/assets/*.jpg
!/mixtape/presentation/assets/*.tex
!/mixtape/presentation/assets/*.json

/mixtape/exercises/*
